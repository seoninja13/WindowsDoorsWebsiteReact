# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API Key (for contact page)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Form Submission API Endpoint
NEXT_PUBLIC_FORM_SUBMISSION_ENDPOINT=your-form-submission-endpoint

# Crawl4AI Configuration
CRAWL4AI_API_KEY=your-crawl4ai-api-key
CRAWL4AI_TARGET_URL=https://www.windowworldla.com
CRAWL4AI_MAX_PAGES=1000
CRAWL4AI_TAKE_SCREENSHOTS=true
